upstream fph_frontend {
    server fph_frontend:3000;
}

upstream fph_backend {
    server backend:8000;
}

# Upstreams for Nectar are handled dynamically in location blocks to allow startup without them

# --- REDIRECT HTTP TO HTTPS ---
server {
    listen 80;
    server_name finanzasparahippies.com www.finanzasparahippies.com staging.finanzasparahippies.com nectarlabs.dev www.nectarlabs.dev losplacosones.nectarlabs.dev localhost;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- FINANZAS PARA HIPPIES (HTTPS) ---
server {
    listen 443 ssl;
    server_name finanzasparahippies.com www.finanzasparahippies.com localhost;

    ssl_certificate ${FPH_SSL_CERT_PATH};
    ssl_certificate_key ${FPH_SSL_KEY_PATH};

    add_header Content-Security-Policy "upgrade-insecure-requests";

    location /static/ {
        alias /app/static/;
    }

    location /media/ {
        alias /app/media/;
    }

    location ~ ^/(api|admin) {
        proxy_pass http://fph_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://fph_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- NECTAR LABS (HTTPS) ---
server {
    listen 443 ssl;
    server_name nectarlabs.dev www.nectarlabs.dev;

    ssl_certificate ${NECTAR_SSL_CERT_PATH};
    ssl_certificate_key ${NECTAR_SSL_KEY_PATH};

    location /static/ {
        alias /app/staticfiles/;
    }

    location /media/ {
        alias /app/media/;
    }

    location ~ ^/(api|admin) {
        resolver 127.0.0.11 valid=30s;
        set $upstream_nectar_back http://nectarlabs-backend-1:8000;
        proxy_pass $upstream_nectar_back;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        resolver 127.0.0.11 valid=30s;
        set $upstream_nectar_front http://nectarlabs-frontend-1:3000;
        proxy_pass $upstream_nectar_front;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- FINANZAS PARA HIPPIES STAGING (HTTPS) ---
server {
    listen 443 ssl;
    server_name staging.finanzasparahippies.com;

    ssl_certificate ${FPH_SSL_CERT_PATH};
    ssl_certificate_key ${FPH_SSL_KEY_PATH};

    add_header Content-Security-Policy "upgrade-insecure-requests";

    # Bloqueo inmediato de escáneres y exploits PHP/WP
    location ~* ^/(wp-admin|wp-includes|wp-content|xmlrpc\.php|wp-login\.php|\.env|\.git|autodiscover|phpmyadmin) { return 444; }
    location ~* \.(php|asp|aspx|jsp|cgi)$ { return 444; }

    location /static/ {
        alias /app/static/;
    }

    location /media/ {
        alias /app/media/;
    }

    location ~ ^/(api|admin) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $upstream_fph_staging_back http://fph_backend_staging:8000;
        proxy_pass $upstream_fph_staging_back;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $upstream_fph_staging_front http://fph_frontend_staging:3000;
        proxy_pass $upstream_fph_staging_front;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout extendido para WebSockets HMR Next.js Staging
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

